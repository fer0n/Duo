            "value" : "Schritte"
          }
        }
      }
    },
    "Steps and cycling count as alternatives — any mix that adds up to 100% completes the week. Set a goal to 0 to leave that activity out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritte und Radfahren zählen als Alternativen — jede Mischung, die zusammen 100% ergibt, schließt die Woche ab. Setze ein Ziel auf 0, um diese Aktivität wegzulassen."
          }
        }
      }
    },
    "That's %@ km to go" : {
      "localizations" : {
