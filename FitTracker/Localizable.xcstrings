      }
    },
    "TK-Fit Challenge" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TK-Fit Challenge"
          }
        }
      }
    },
    "Today" : {
      "localizations" : {
        "de" : {
