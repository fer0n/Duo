          }
        }
      }
    },
    "This app is an unofficial companion to the TK-Fit Challenge, helping you track your progress toward its weekly step and cycling goals." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App ist eine inoffizielle Begleit-App zur TK-Fit Challenge und hilft dir, deinen Fortschritt bei den wöchentlichen Schritt- und Radfahrzielen zu verfolgen."
          }
        }
      }
    },
    "This Week" : {
      "localizations" : {
        "de" : {
