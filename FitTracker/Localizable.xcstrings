    },
    "Today's progress toward the daily target." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heutiger Fortschritt zum Tagesziel."
          }
        }
      }
    },
    "Today's steps and cycling, hour by hour." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heutige Schritte und Radfahren, Stunde für Stunde."
          }
